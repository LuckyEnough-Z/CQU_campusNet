#!/bin/sh /etc/rc.common
USE_PROCD=1
START=95
EXTRA_COMMANDS="reassert"
EXTRA_HELP="        reassert   Re-apply nft/ip-rule/route only if missing (self-heal)"

setup_tproxy() {
    nft delete table inet tproxy_table 2>/dev/null
    nft -f /etc/nfts/100-tproxy.nft
    nft delete table inet cqu_hardening 2>/dev/null
    nft -f /etc/nfts/110-cqu-hardening.nft
    grep -q "^100[[:space:]].*tproxy$" /etc/iproute2/rt_tables 2>/dev/null || echo "100 tproxy" >> /etc/iproute2/rt_tables
    ip rule show | grep -q "fwmark 0x1 lookup tproxy" || ip rule add fwmark 1 lookup tproxy
    ip route show table tproxy 2>/dev/null | grep -q "local default" || ip route add local 0.0.0.0/0 dev lo table tproxy
}
cleanup_tproxy() {
    nft delete table inet tproxy_table 2>/dev/null
    nft delete table inet cqu_hardening 2>/dev/null
    ip route del local 0.0.0.0/0 dev lo table tproxy 2>/dev/null
    ip rule del fwmark 1 lookup tproxy 2>/dev/null
}
# 自愈: 仅在缺失时重装, 不动 hev 进程/已建连接 (幂等, 供 cron/hotplug/procd-trigger 高频无害调用)
reassert() {
    need=0
    ip rule show | grep -q "fwmark 0x1 lookup tproxy" || need=1
    ip route show table tproxy 2>/dev/null | grep -q "local default" || need=1
    nft list table inet tproxy_table >/dev/null 2>&1 || need=1
    nft list table inet cqu_hardening >/dev/null 2>&1 || need=1
    if [ "$need" = 1 ]; then
        setup_tproxy
        logger -t tproxy_service "reassert: tproxy chain was broken -> re-applied"
    fi
}
start_service() {
    setup_tproxy
    procd_open_instance
    procd_set_param command /usr/bin/hev-socks5-tproxy /etc/hevproxy.yml
    procd_set_param respawn
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
stop_service() { cleanup_tproxy; killall hev-socks5-tproxy 2>/dev/null; }
service_triggers() {
    procd_add_interface_trigger "ifup" "wan" /etc/init.d/tproxy_service reassert
    procd_add_interface_trigger "ifup" "lan" /etc/init.d/tproxy_service reassert
}
