#!/bin/sh /etc/rc.common

USE_PROCD=1
START=95
DEPENDS="rpcd"

boot() {
    service_start /usr/sbin/rpcd -f
}

setup_sysctl() {
    sysctl -p /etc/sysctl.d/20-ecmp.conf >/dev/null 2>&1
}

start_service() {
    setup_sysctl
    procd_open_instance
    procd_set_param command /usr/bin/cquauth_client
    procd_set_param respawn 3600 5 10
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

stop_service() {
    killall cquauth_client
}

reload_service() {
    stop
    start
}

# 监听 /etc/config/cquauth 变更, LuCI/uci commit cquauth 后 procd 自动 reload daemon
# (修复 1.0.6 之前漏 service_triggers 导致改账号/切 phone-pc 需手动重启的问题)
service_triggers() {
    procd_add_reload_trigger "cquauth"
}