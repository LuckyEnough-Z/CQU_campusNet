'use strict';

import { popen } from 'fs';

const LOGIN_HOST = 'login.cqu.edu.cn';

// chkstatus JSONP: dr1002({"result":1,"uid":"...","v46ip":"...","time":"...","flow":"...","NID":"..."})
// login JSONP:     dr1004({"result":1,"msg":"认证成功"})
const match_dr_payload = /dr\d+\(([^)]+)\)/;
const match_result    = /"result"\s*:\s*([0-9]+)/;
const match_msg       = /"msg"\s*:\s*"([^"]*)"/;
const match_uid       = /"uid"\s*:\s*"([^"]+)"/;
const match_v46ip     = /"v46ip"\s*:\s*"([^"]+)"/;
const match_time      = /"time"\s*:\s*"?([0-9]+)"?/;
const match_flow      = /"flow"\s*:\s*"?([0-9]+)"?/;

function safe_exec(cmd) {
    return trim(popen(cmd)?.read?.('all') ?? '');
}

function exec(cmd) {
    return popen(cmd)?.read?.('all') ?? '';
}

function log(msg) {
    exec('logger -t cquauth_client ' + msg);
}

function log_ifname(ifname, msg) {
    log(sprintf('[%s] %s', ifname, msg));
}

function url_encode(str) {
    const hex = "0123456789ABCDEF";
    let res = "";

    for (let i = 0; i < length(str); i++) {
        let c = substr(str, i, 1);
        let code = ord(c);

        if (
            (code >= 48 && code <= 57) ||  // 0-9
            (code >= 65 && code <= 90) ||  // A-Z
            (code >= 97 && code <= 122) || // a-z
            (c == "-" || c == "_" || c == "." || c == "~")
        ) {
            res += c;
        } else if (code == 32) {
            res += "%20";
        } else if (code == 40) {
            res += "(";
        } else if (code == 41) {
            res += ")";
        } else {
            res += "%" + substr(hex, (code >> 4) & 0xF, 1) + substr(hex, code & 0xF, 1);
        }
    }

    return res;
}

function get_gw(ifname) {
    if (!ifname) {
        return 'N/A';
    }
    const cmd = sprintf('ip -j route show default | jq -r \'[.[] | select(.dev == %s)][0].gateway\'', ifname);
    return exec(cmd);
}

// 调用 login.cqu.edu.cn/drcom/chkstatus, 解析 JSONP 内容
function fetch_chkstatus(iface) {
    const url = sprintf('http://%s/drcom/chkstatus?callback=dr1002&jsVersion=4.X&v=5505&lang=zh', LOGIN_HOST);
    // 用 uclient-fetch 而非 curl: 部分固件 curl 与 libcurl 版本不匹配会 symbol-not-found,
    // uclient-fetch 是 OpenWrt 基础组件, 更可靠且无依赖. 单 WAN 下无需 --interface.
    const cmd = sprintf('uclient-fetch -q -T 5 -O - "%s" 2>/dev/null', url);
    const raw = safe_exec(cmd);
    const payload = match(raw, match_dr_payload)?.[1] ?? '';
    return {
        raw: raw,
        payload: payload,
        v46ip: match(payload, match_v46ip)?.[1],
        uid:   match(payload, match_uid)?.[1],
        time:  match(payload, match_time)?.[1],
        flow:  match(payload, match_flow)?.[1],
        result: match(payload, match_result)?.[1]
    };
}

function get_ip(ifname) {
    if (!ifname) {
        return 'N/A';
    }
    return fetch_chkstatus(ifname).v46ip ?? 'N/A';
}

// 触发共享检测时, 调诊断脚本抓 conntrack/端口/DHCP 快照, 返回快照文件路径.
// 详情见 /usr/share/cquauth/diag-sharing.sh
function diagnose_sharing(ifname) {
    const path = trim(safe_exec(sprintf('/usr/share/cquauth/diag-sharing.sh %s 2>/dev/null', ifname ?? 'unknown')));
    return path != '' ? path : null;
}

const methods = {
    ping: {
        call: function() {
            return { success: true };
        }
    },
    service: {
        args: { action: 'string' },
        call: function(req) {
            const action = req.args?.action ?? 'restart';
            return exec(`/etc/init.d/cquauth_client ${action}`);
        }
    },
    // 未登录时 chkstatus 不会返回 uid; 任一字段为 N/A 即视为未登录
    get_status: {
        args: { interface: 'string' },
        call: function(req) {
            const iface = req.args?.interface ?? 'eth0';
            const info = fetch_chkstatus(iface);
            log_ifname(iface, `chkstatus payload length: ${length(info.payload)}`);
            if (length(info.payload) == 0) {
                log_ifname(iface, `Please check your connection to ${LOGIN_HOST}`);
            }
            const status = {
                time: info.time ?? 'N/A',
                flow: info.flow ?? 'N/A',
                uid:  info.uid  ?? 'N/A',
                v4ip: info.v46ip ?? 'N/A'
            };

            log_ifname(iface, `Current status: time=${status.time}, flow=${status.flow}, uid=${status.uid}, v4ip=${status.v4ip}`);
            return status;
        }
    },
    get_ip: {
        args: { interface: 'string' },
        call: function(req) {
            const iface = req.args?.interface ?? 'eth0';
            const ip = get_ip(iface);
            return { ip };
        }
    },
    // 手动抓一份共享检测诊断快照. 用于未触发但怀疑被检测时主动排查.
    diagnose: {
        args: { interface: 'string' },
        call: function(req) {
            const iface = req.args?.interface ?? 'eth0';
            const path = diagnose_sharing(iface);
            if (!path) {
                return { success: false, message: '诊断脚本执行失败' };
            }
            log_ifname(iface, `手动诊断快照: ${path}`);
            return { success: true, path: path };
        }
    },
    enable_ecmp: {
        args: { interfaces: [], table: "main" },
        call: function(req) {
            const ifaces = req.args?.interfaces ?? [];
            if (length(ifaces) == 0) {
                log('Invalid interface name');
                return { success: false, message: 'Invalid interface name' };
            }
            const nexthop_str = "nexthop via %s dev %s weight 1";
            const nexthop_strs = join(' ', map(ifaces, ifname => sprintf(nexthop_str, get_gw(ifname), ifname)));
            const cmd = sprintf('ip route table %s replace default %s', req.args?.table ?? "main", nexthop_strs);
            const result = exec(cmd);
            log(`Enable ecmp: ${result} ${cmd}`);
            return { success: result == '', message: 'Enable ecmp routing' };
        }
    },
    login: {
        args: {
            user: 'string',
            pass: 'string',
            interface: 'string',
            ua: 'string',
            terminal_type: 'string'
        },
        call: function(req) {
            const args = req.args;
            if (!args.user || !args.pass || !args.ua || !args.interface || !args.terminal_type) {
                log('参数不完整, 请检查配置文件');
                return { success: false, message: '参数不完整' };
            }
            const callback  = (args.terminal_type == 'phone') ? 'dr1005'   : 'dr1004';
            const prefix    = (args.terminal_type == 'phone') ? '%2C1%2C'  : '%2C0%2C';
            const term_type = (args.terminal_type == 'phone') ? '2'        : '1';
            const iface = args.interface ?? 'eth0';

            log_ifname(iface, `logining, account: ${args.user}, terminal_type: ${args.terminal_type}`);
            const ip = get_ip(iface);
            log_ifname(iface, `Resolved IP: ${ip ?? 'N/A'}`);
            if (ip == 'N/A') {
                log_ifname(iface, '无法获取IP地址');
                return { success: false, message: '无法获取IP地址' };
            }
            const url = sprintf(
                'http://%s:801/eportal/portal/login?callback=%s&login_method=1&user_account=%s%s&user_password=%s&wlan_user_ip=%s&wlan_user_ipv6=&wlan_user_mac=000000000000&wlan_ac_ip=&wlan_ac_name=&term_ua=%s&term_type=%s&jsVersion=4.2.2&terminal_type=%s&lang=zh-cn&v=1176&lang=zh-cn',
                LOGIN_HOST, callback, prefix, url_encode(args.user), url_encode(args.pass), ip, url_encode(args.ua), term_type, term_type
            );
            log_ifname(iface, `Generated URL: ${substr(url, 43, 150)}...`);

            // uclient-fetch 不支持任意 --header/--interface; 认证逻辑全在 URL query
            // (term_ua 已 url_encode 在 URL 内), drcom eportal 不强校验 Referer/UA 头.
            const cmd = sprintf(
                'uclient-fetch -q -T 5 -O - "%s" 2>/dev/null',
                url
            );
            let success = false, message, ret;
            const raw = safe_exec(cmd);
            log_ifname(iface, `Login command output length: ${length(raw)}`);
            if (length(raw) == 0) {
                log_ifname(iface, `Check your connection to ${LOGIN_HOST}`);
                ret = 21;
                message = '无法连接到认证服务器';
                return { success, message, ret, result: raw };
            }

            const payload = match(raw, match_dr_payload)?.[1];
            if (!payload) {
                ret = 1;
                message = '响应格式异常';
                log_ifname(iface, `Login response not JSONP: ${substr(raw, 0, 200)}`);
                return { success, message, ret, result: raw };
            }
            const result_code = +(match(payload, match_result)?.[1] ?? '0');
            const msg = match(payload, match_msg)?.[1] ?? '';

            if (result_code == 1) {
                success = true;
                message = msg || '认证成功';
                ret = 0;
            }
            else if (index(msg, '密码错误') != -1) {
                message = '密码错误';
                ret = 2;
            }
            else if (index(msg, '账号不存在') != -1) {
                message = '账号不存在';
                ret = 3;
            }
            else if (index(msg, '认证异常') != -1) {
                message = '认证异常';
                ret = 4;
            }
            else if (index(msg, '认证操作非本机终端') != -1) {
                message = '认证操作非本机终端';
                log_ifname(iface, '请检查出口IP和接口是否正确');
                ret = 5;
            }
            else if (index(msg, '本账号费用超支') != -1) {
                message = '本账号费用超支';
                ret = 6;
            }
            else if (index(msg, '共享上网') != -1 || index(msg, '等待5分钟') != -1 || index(msg, '请勿使用代理') != -1) {
                message = '触发共享检测';
                log_ifname(iface, '触发共享检测, 建议禁用http明文流量');
                const diag = diagnose_sharing(iface);
                if (diag) {
                    log_ifname(iface, `诊断快照已写入: ${diag} (cat 查看, 看 http/uniq_sport 高的客户端)`);
                }
                ret = 7;
            }
            else {
                message = msg ? ('其他错误: ' + msg) : '其他错误';
                ret = 20;
            }
            log_ifname(iface, `Login result: success=${success}, message=${message}, payload=${substr(payload, 0, 100)}`);
            return { success, message, ret, result: payload };
        }
    }
};
log('Service started');
return { 'cquauth': methods };
